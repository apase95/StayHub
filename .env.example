DB_NAME=stayhub_db
DB_USERNAME=stayhub_user
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432
APP_PORT=8080

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME="StayHub Administrator"

UPLOAD_USE_CLOUDINARY=false
UPLOAD_LOCAL_DIRECTORY=uploads
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=50MB
UPLOAD_MAX_IMAGES_PER_PROPERTY=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_ENABLED=false
MAIL_SYSTEM_NAME="StayHub System"
MAIL_FROM=stayhub.system@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=stayhub.system@example.com
MAIL_PASSWORD=replace-with-mail-app-password

# Google OAuth2 login. Redirect URI in Google Console:
# http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
